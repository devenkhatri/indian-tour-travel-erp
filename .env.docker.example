# ==============================================================================
# BharatTravel Holidays ERP & Marketplace - Docker Environment Configuration
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env
# ==============================================================================

APP_NAME="BharatTravel ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Docker Container Host Ports
# ------------------------------------------------------------------------------
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

# ------------------------------------------------------------------------------
# MySQL Database (Connected via Docker internal network service name: db)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=travelcrm
DB_USERNAME=travelcrm
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# ------------------------------------------------------------------------------
# Redis In-Memory Cache, Session & Queue (Connected via service name: redis)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# Local Email Testing via Mailpit (Web UI: http://localhost:8025, SMTP: 1025)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@bharattravel.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKey

# ------------------------------------------------------------------------------
# Travel Agency & GST Compliance Defaults
# ------------------------------------------------------------------------------
DEFAULT_GST_RATE=5
DEFAULT_SAC_CODE=998555
